# ==============================================================================
# VaultPay Frontend Configuration - Example Template
# ==============================================================================
# INSTRUCTIONS:
# Copy this file to '.env' and populate with actual credentials.
# Vite strictly requires the 'VITE_' prefix for any variable exposed to the client.
# ==============================================================================

# VITE_APP_NAME: The human-readable name of the application.
# Used in the document title and UI branding.
VITE_APP_NAME=VaultPay Financial Core

# VITE_API_BASE_URL: The absolute URL pointing to the backend API.
# During local development, this points to the local Node.js server.
# In production, it must point to the deployed backend URL.
VITE_API_BASE_URL=http://localhost:3000/api/v1

# VITE_STRIPE_PUBLISHABLE_KEY: Your public Stripe key.
# Safe to expose to the browser; used by Stripe.js to tokenize card details securely.
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
